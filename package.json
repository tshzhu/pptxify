{
  "name": "pptxify",
  "version": "0.1.0",
  "description": "Convert PDF pages to high-quality image-based PPTX files in the browser.",
  "homepage": "https://tshzhu.github.io/pptxify/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tshzhu/pptxify.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "pptxify": "dist-cli/cli.js"
  },
  "files": [
    "dist-cli/",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:cli": "tsc -p tsconfig.cli.json",
    "build:all": "npm run build && npm run build:cli",
    "prepare": "npm run build:cli",
    "preview": "vite preview",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.100",
    "jszip": "3.10.1",
    "pdfjs-dist": "5.4.624",
    "pptxgenjs": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
